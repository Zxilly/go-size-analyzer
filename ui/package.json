{
  "name": "go-size-analyzer-ui",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build:ui": "tsc && vite -c vite.config.ts build",
    "build:explorer": "tsc && vite -c vite.config-explorer.ts build",
    "dev:ui": "vite -c vite.config.ts",
    "dev:explorer": "vite -c vite.config-explorer.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "d3-array": "^3.2.4",
    "d3-color": "^3.1.0",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.0.0",
    "react-use": "^17.6.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@codecov/vite-plugin": "2.0.1",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/d3-array": "^3.2.2",
    "@types/d3-color": "^3.1.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/golang-wasm-exec": "^1.15.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^30.0.1",
    "sass": "^1.103.1",
    "terser": "^5.50.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "10"
      }
    },
    "overrides": {
      "brace-expansion@1.1.16": "1.1.18",
      "brace-expansion@2.1.2": "2.1.4",
      "brace-expansion@5.0.6": "5.0.8",
      "micromatch": "4.0.8"
    }
  }
}
